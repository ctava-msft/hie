.create-merge table EpnaMonitoringSignal (
    AlertId:string,
    EncounterId:string,
    PatientReference:string,
    FacilityId:string,
    EncounterStatus:string,
    EncounterClassCode:string,
    MonitoringStatus:string,
    AlertEligible:bool,
    AlertScore:real,
    AlertReasonCode:string,
    AlertReasonDisplay:string,
    SupportingResourceReferences:dynamic,
    QualificationPolicyVersion:string,
    EvaluatedAt:datetime,
    EventTime:datetime,
    SourceEventId:string,
    CorrelationId:string
)

.create-or-alter function with (
    folder = "ePNA",
    docstring = "Latest clinician-approved alert-eligible signal for each active emergency encounter."
) EpnaAlertCandidates() {
    EpnaMonitoringSignal
    | where EventTime > ago(5m)
    | where AlertEligible == true
    | where MonitoringStatus == "qualified"
    | where EncounterStatus == "in-progress"
    | where EncounterClassCode == "EMER"
    | summarize arg_max(EventTime, *) by EncounterId
    | project
        EncounterId,
        EventTime,
        AlertScore,
        AlertReasonCode,
        AlertReasonDisplay,
        FacilityId,
        CorrelationId
}

.alter-merge table GoldFhirResource policy retention softdelete = 365d recoverability = enabled

.alter-merge table EpnaMonitoringSignal policy retention softdelete = 30d recoverability = enabled
