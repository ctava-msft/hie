    Display:string,
    EffectiveDateTime:datetime,
    IssuedDateTime:datetime,
    SourceHl7Version:string,
    SourceMessageType:string,
    SourceMessageControlId:string,
    SourceEventId:string,
    BronzeEventId:string,
    SilverEventId:string,
    MappingVersion:string,
    UscdiVersion:string,
    UscdiPlusDomain:string,
