# Copy to .env. Plain KEY=value syntax; do not add "export" or shell-style quotes.
# Replace BOTH keys with distinct cryptographically random values (at least 32 characters).
WEBHOOK_API_KEY=CHANGE-ME-WEBHOOK-KEY-AT-LEAST-32-CHARACTERS
ADMIN_API_KEY=CHANGE-ME-ADMIN-KEY-AT-LEAST-32-CHARACTERS

# Fully qualified namespace, not a URL. Prefer Azure credentials/workload identity.
SERVICE_BUS_NAMESPACE=your-namespace.servicebus.windows.net
SERVICE_BUS_QUEUE=activator-deliveries
# Local development alternative; never commit a real connection string.
SERVICE_BUS_CONNECTION_STRING=
WORKER_ENABLED=true
WORKER_CONCURRENCY=4

# Deliberate non-routable placeholder. Set before sending real events.
DOWNSTREAM_URL=https://example.invalid/activator
DOWNSTREAM_BEARER_TOKEN=

FABRIC_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
FABRIC_ACTIVATOR_ID=00000000-0000-0000-0000-000000000000
# DefaultAzureCredential: use az login locally, or AKS Workload Identity.
# Optional local service principal (omit AZURE_CLIENT_SECRET in AKS):
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
AUDIT_DIRECTORY=./data/deployments
